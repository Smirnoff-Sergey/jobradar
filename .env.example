# Скопируйте в .env и заполните.
# Вложенные настройки задаются через двойное подчёркивание: JOBRADAR_<БЛОК>__<ПАРАМЕТР>.

# Секрет для подписи JWT, не короче 32 символов.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JOBRADAR_AUTH__JWT_SECRET=

# Время жизни токенов.
JOBRADAR_AUTH__ACCESS_TOKEN_TTL_MINUTES=15
JOBRADAR_AUTH__REFRESH_TOKEN_TTL_DAYS=30

# Сбор вакансий: расписание (cron: минута час день месяц день_недели, время UTC),
# поведение HTTP-клиента и темп загрузки карточек вакансий.
JOBRADAR_COLLECTOR__SCHEDULE_CRON=0 * * * *
JOBRADAR_COLLECTOR__REQUEST_TIMEOUT_SECONDS=30
JOBRADAR_COLLECTOR__HTTP_MAX_ATTEMPTS=4
JOBRADAR_COLLECTOR__DETAILS_RATE_LIMIT=30/m

# LLM-оценка вакансий через OpenRouter (OpenAI-совместимый API). Без ключа оценка выключена.
# Разрешены только бесплатные модели (суффикс :free) — платные приложение не примет.
JOBRADAR_LLM__API_KEY=
JOBRADAR_LLM__MODELS=["xingchen-agi/xing4.0-29b-a4b:free", "google/gemma-4-31b-it:free", "dots-studio/dots-3-note-preview:free"]
# Свой потолок запросов в сутки (UTC); у бесплатного тарифа OpenRouter — 50.
JOBRADAR_LLM__DAILY_REQUEST_LIMIT=35

# Telegram-бот (токен от @BotFather). Без токена уведомления выключены.
JOBRADAR_TELEGRAM__BOT_TOKEN=
# polling — отдельный контейнер bot, публичный адрес не нужен; webhook — обновления принимает API.
JOBRADAR_TELEGRAM__MODE=polling
# Для webhook: секрет, который Telegram присылает в заголовке каждого запроса.
JOBRADAR_TELEGRAM__WEBHOOK_SECRET=

# PostgreSQL в docker compose.
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar
POSTGRES_DB=jobradar

# Порт API на хосте.
API_PORT=8000

# Порт веб-интерфейса на хосте.
FRONTEND_PORT=8080

# Логи: уровень и формат (json — для контейнеров, console — читать глазами).
JOBRADAR_LOGGING__LEVEL=INFO
JOBRADAR_LOGGING__FORMAT=json

# Мониторинг (docker compose --profile monitoring up -d): порты и пароль администратора Grafana.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
