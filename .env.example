# Скопируйте в .env и заполните.

# Секрет для подписи JWT, не короче 32 символов.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JOBRADAR_JWT_SECRET=

# Время жизни токенов.
JOBRADAR_ACCESS_TOKEN_TTL_MINUTES=15
JOBRADAR_REFRESH_TOKEN_TTL_DAYS=30

# PostgreSQL в docker compose.
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar
POSTGRES_DB=jobradar

# Порт API на хосте.
API_PORT=8000
